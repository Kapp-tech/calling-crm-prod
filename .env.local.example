# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/counselling_crm?schema=public"

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-here"

# App URL
NEXTAUTH_URL="http://localhost:3000"

# ── DialShree dialer (click-to-call) ─────────────────────────────────────────
# Credentials for the Elision/DialShree tenant. The server logs in with these
# to mint a bearer token (rotated by the provider roughly every 30 minutes),
# so the token itself is never stored. Leave unset to disable calling — the
# Call button then reports that the dialer is not configured rather than
# erroring.
DIALSHREE_USER=""
DIALSHREE_PASSWORD=""
# Country code sent alongside the 10-digit subscriber number. Defaults to 91.
DIALSHREE_PHONE_CODE="91"
