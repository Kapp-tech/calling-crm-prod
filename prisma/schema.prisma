generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  REPORTS
  OPERATIONS
  COUNSELLING_TL
  COUNSELLING_AGENT
}

enum Feature {
  VIEW_REPORTS
  DOWNLOAD_DATA
  MASK_UNMASK_DATA
  UPLOAD_LEADS
  APPROVE_LEADS
  ASSIGN_LEADS
  VIEW_LEADS
  SUBMIT_FEEDBACK
  APPROVE_RECEIPTS
}

enum LeadStatus {
  PENDING
  APPROVED
  DISAPPROVED
}

enum DropdownType {
  COLLEGE
  LEAD_TYPE
  LEAD_ORIGIN
  ZONE
  LEAD_CONFIRMATION
  LEAD_STAGE
  LEAD_VERIFICATION
  DATA_CALLING_TYPE
  DEAL_TYPE
}

enum BatchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ScheduledCallStatus {
  PENDING
  DONE
  CANCELLED
}

enum NotificationType {
  LEAD_ASSIGNED
  // The ingestion API moved one of the agent's leads to a new stage. Sent only
  // when the lead is actually assigned to someone — an unassigned lead has
  // nobody to tell.
  LEAD_STAGE_CHANGED
  CALL_REMINDER
  CALL_NOW
  RECEIPT_SUBMITTED
  RECEIPT_APPROVED
  RECEIPT_DISAPPROVED
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL // TL-requested agents awaiting SA approval
}

enum ReceiptType {
  APPLICATION
  ADMISSION
}

enum ReceiptStatus {
  PENDING
  APPROVED
  DISAPPROVED
}

enum WorkType {
  WFH
  WFO
}

enum BreakType {
  LUNCH
  BIO
  TEA
}

enum ActivityAction {
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_APPROVED
  USER_REJECTED
  LEAD_ASSIGNED
  LEAD_APPROVED
  LEAD_DISAPPROVED
  LEAD_DELETED
  FEEDBACK_SUBMITTED
  PERMISSION_CHANGED
  CSV_UPLOADED
  TEAM_CREATED
  TEAM_UPDATED
  AGENT_TRANSFER
  TL_TRANSFER
  PASSWORD_CHANGED
  BATCH_APPROVED
  BATCH_DISAPPROVED
  REFERRAL_ADDED
  RECEIPT_APPROVED
  RECEIPT_DISAPPROVED
  API_KEY_CREATED
  API_KEY_REVOKED
  LEAD_CREATED_VIA_API
  SECURITY_PIN_CHANGED
  SECURITY_ACTION_UNLOCKED
  LEAD_INTEGRATION_CREATED
  LEAD_INTEGRATION_UPDATED
  LEAD_INTEGRATION_DELETED
  LEADS_EXPORTED
  // Click-to-call via the DialShree dialer. CALL_INITIATED records who dialled
  // which lead; the dialer itself holds the CDR and recording.
  CALL_INITIATED
  CALL_HANGUP
}

// Which CRM event fires a configured push — only referral-lead creation for
// now (that's the one concrete need); more triggers can be added to this
// enum later without touching the LeadIntegration table shape.
enum LeadIntegrationTrigger {
  REFERRAL_CREATED
}

/// Where a KPI's number comes from. A KPI is defined by picking one of these
/// and then narrowing it with the fields on KpiDefinition, so a new KPI is
/// configuration rather than code.
enum KpiSource {
  /// Feedback the agent logged in the period, optionally narrowed to particular
  /// feedback options or whole categories. Leave both empty to count them all.
  FEEDBACK_COUNT
  /// Distinct leads the agent gave that feedback to in the period — use this
  /// when repeat follow-ups on one lead should count once.
  FEEDBACK_LEADS
  /// A live count of the agent's assigned leads currently at the chosen Lead
  /// Stage(s). A snapshot: it ignores the period and the same lead keeps
  /// counting while it sits there.
  LEAD_STAGE_LIVE
  /// Approved receipts for the agent's leads in the period, by date paid.
  RECEIPT_COUNT
  /// Leads assigned to the agent during the period.
  LEADS_ASSIGNED
  /// Total talk time in whole minutes, from the dialer's post-call webhook.
  CALL_TALKTIME_MINUTES
  /// Calls the dialer reported for the agent in the period.
  CALL_COUNT
  /// Calls where the two parties actually spoke (talk time above zero) — the
  /// dialer reports rung-but-unanswered calls too.
  CALL_CONNECTED_COUNT
  /// No source — a target can be set but achievement is left blank, for things
  /// the CRM genuinely cannot see.
  NOT_MEASURED
}

enum KpiPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String
  role         Role
  status       UserStatus @default(ACTIVE)
  isActive     Boolean    @default(true)
  employeeCode String     @unique
  phone        String?
  workType     WorkType   @default(WFO)
  /// Which zone this agent covers — the same five values colleges use, so the
  /// two line up on reports. Null until an admin sets it.
  zone         String?
  /// Languages the agent can counsel in, free text (e.g. "Hindi, English").
  /// Deliberately not a dropdown: the list is long, regional and changes often,
  /// and a wrong-but-close value here is harmless.
  language     String?
  joiningDate  DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // This agent's user id in the DialShree dialer (the `agent_user` parameter of
  // its manual-dial / external-hangup APIs). Click-to-call needs it to bridge
  // the call to the right agent's softphone, so an agent without it cannot
  // dial. Mapped by hand when the account is created — the two systems have no
  // shared key. Unique so two CRM users can never point at the same dialer
  // seat, which would ring the wrong person.
  dialshreeId String? @unique

  // Second-factor 6-digit PIN gating especially destructive Super Admin
  // tools (e.g. Bulk Delete Leads) — separate from the account password.
  // Null until the admin sets one up from their profile page.
  securityPinHash           String?
  securityPinSetAt          DateTime?
  securityPinFailedAttempts Int                 @default(0)
  securityPinLockedUntil    DateTime?
  adminActionUnlocks        AdminActionUnlock[]

  // KPIs and targets this user has authored. Both are organisation-wide rather
  // than per user, so there is no inverse "targets for me" relation.
  kpiDefinitions KpiDefinition[] @relation("KpiDefinitionCreatedBy")
  kpiTargetsSet  KpiTarget[]     @relation("KpiTargetSetBy")
  callLogs       CallLog[]

  // Generic manager link (SA → TL, TL → Agent, SA → Operations)
  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id])
  reports   User[]  @relation("UserManager")

  // Legacy TL→Agent relation kept for compatibility
  managedById String?
  managedBy   User?   @relation("TLAgents", fields: [managedById], references: [id])
  agents      User[]  @relation("TLAgents")

  // Team membership (TL is teamLead, Agents are members)
  teamId String?
  team   Team?   @relation("TeamMembers", fields: [teamId], references: [id])

  // Teams this user leads
  ledTeams Team[] @relation("TeamLead")

  // Operations group membership
  operationsGroupId String?
  operationsGroup   OperationsGroup? @relation("GroupMembers", fields: [operationsGroupId], references: [id])

  // Teams created by SA
  createdTeams            Team[]            @relation("TeamCreator")
  createdOperationsGroups OperationsGroup[] @relation("GroupCreator")
  managedGroups           OperationsGroup[] @relation("GroupManager")

  // Lead relations
  uploadedLeads            Lead[]                @relation("UploadedBy")
  approvedLeads            Lead[]                @relation("ApprovedBy")
  disapprovedLeads         Lead[]                @relation("DisapprovedBy")
  assignedLeads            Lead[]                @relation("AssignedTo")
  assignedByLeads          Lead[]                @relation("AssignedBy")
  assignedFromLeads        Lead[]                @relation("AssignedFrom")
  prevAssignee2Leads       Lead[]                @relation("PrevAssignee2")
  feedbacks                LeadFeedback[]
  archivedFeedbacks        LeadFeedbackArchive[] @relation("ArchivedFeedbackAgent")
  archivedFeedbacksResetBy LeadFeedbackArchive[] @relation("ArchivedFeedbackBy")
  uploadBatches            UploadBatch[]

  scheduledCalls          ScheduledCall[]   @relation("AgentSchedules")
  notifications           Notification[]
  uploadedReceipts        LeadReceipt[]     @relation("ReceiptUploadedBy")
  reviewedReceipts        LeadReceipt[]     @relation("ReceiptReviewedBy")
  attendances             Attendance[]
  apiKeysCreated          ApiKey[]          @relation("ApiKeyCreatedBy")
  leadIntegrationsCreated LeadIntegration[] @relation("LeadIntegrationCreatedBy")

  // Feedback options created by this user (SA)
  createdFeedbackOptions FeedbackOption[] @relation("FeedbackOptionCreator")

  // Feedback categories (Hot/Warm/Cold etc.) created by this user (SA)
  createdFeedbackCategories FeedbackCategory[] @relation("FeedbackCategoryCreator")

  // Dropdown options created by this user (SA)
  createdDropdownOptions DropdownOption[] @relation("DropdownOptionCreator")

  // Activity log
  activityLogs ActivityLog[]

  // Announcements authored by this user (SA)
  announcements Announcement[]

  // Rejection reason when SA rejects a TL-requested agent
  rejectionReason String?

  // Daily upload limit (null = unlimited). Only meaningful for OPERATIONS role.
  uploadLimit Int?

  @@index([role])
  @@index([teamId])
  @@index([isActive])
  @@index([role, isActive])
}

/// A KPI the organisation measures — created and edited from the KPI page
/// rather than defined in code, so a new one is a form, not a release.
///
/// `source` chooses the shape of the query and the fields below narrow it. Only
/// the fields relevant to the chosen source are read; the rest stay empty.
model KpiDefinition {
  id     String    @id @default(cuid())
  name   String    @unique
  /// Shown after the number, e.g. "calls", "leads", "min".
  unit   String    @default("")
  source KpiSource

  /// FEEDBACK_COUNT / FEEDBACK_LEADS — narrow to these options, and/or every
  /// option in these categories. Both empty means "any feedback".
  feedbackOptionIds   String[]
  feedbackCategoryIds String[]
  /// LEAD_STAGE_LIVE — the Lead Stage values that count.
  leadStages          String[]
  /// RECEIPT_COUNT — which receipt type counts.
  receiptType         ReceiptType?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdById String
  createdBy   User   @relation("KpiDefinitionCreatedBy", fields: [createdById], references: [id])

  targets   KpiTarget[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([isActive, sortOrder])
}

/// One organisation-wide target per KPI per period length.
///
/// Deliberately not per agent: the same expectation applies to everyone, so
/// changing it is a single edit and a new joiner is measured from day one.
/// Cascades with its definition — deleting a KPI takes its targets with it.
///
/// Targets are absolute counts for the period: a DAILY target of 50 means 50
/// per day, not 50 spread across the week.
model KpiTarget {
  id           String        @id @default(cuid())
  definitionId String
  definition   KpiDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  period KpiPeriod
  target Int

  setById String
  setBy   User   @relation("KpiTargetSetBy", fields: [setById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([definitionId, period])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamLeadId String?
  teamLead   User?   @relation("TeamLead", fields: [teamLeadId], references: [id])

  createdById String
  createdBy   User   @relation("TeamCreator", fields: [createdById], references: [id])

  members User[] @relation("TeamMembers")
  leads   Lead[] @relation("TeamLeads")
}

model OperationsGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  managerId String
  manager   User   @relation("GroupManager", fields: [managerId], references: [id])

  createdById String
  createdBy   User   @relation("GroupCreator", fields: [createdById], references: [id])

  members User[] @relation("GroupMembers")
}

model Permission {
  id        String  @id @default(cuid())
  role      Role
  feature   Feature
  canAccess Boolean @default(false)

  @@unique([role, feature])
}

model Lead {
  id            String     @id @default(dbgenerated("('LID' || nextval('lead_id_seq'::regclass))"))
  name          String
  email         String
  phone         String
  city          String?
  state         String?
  course        String?
  college       String?
  kappCollegeId String?
  campaign      String?
  leadType      String?
  leadOrigin    String?
  leadZone      String?
  status        LeadStatus @default(PENDING)

  uploadedById String
  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])

  // Set only for leads created through POST /api/v1/leads — lets an admin
  // trace a lead back to the specific partner integration that sent it.
  apiKeyId String?
  apiKey   ApiKey? @relation("LeadCreatedByApiKey", fields: [apiKeyId], references: [id])

  approvedById String?
  approvedBy   User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  disapprovedById   String?
  disapprovedBy     User?     @relation("DisapprovedBy", fields: [disapprovedById], references: [id])
  disapprovedAt     DateTime?
  disapprovalReason String?

  assignedToId String?
  assignedTo   User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedAt   DateTime?

  assignedById String?
  assignedBy   User?   @relation("AssignedBy", fields: [assignedById], references: [id])

  assignedFromId String?
  assignedFrom   User?   @relation("AssignedFrom", fields: [assignedFromId], references: [id])

  prevAssignee2Id String?
  prevAssignee2   User?   @relation("PrevAssignee2", fields: [prevAssignee2Id], references: [id])

  batchId String?
  batch   UploadBatch? @relation(fields: [batchId], references: [id])

  // Team the lead is assigned to (set when TL assigns to agent)
  teamId String?
  team   Team?   @relation("TeamLeads", fields: [teamId], references: [id])

  feedbacks      LeadFeedback[]
  stageHistory   LeadStageEntry[]
  profile        LeadProfile?
  scheduledCalls ScheduledCall[]
  receipts       LeadReceipt[]

  // Archived feedback from before the most recent "reassign as fresh" reset —
  // preserved for TL/Super Admin visibility even though the live `feedbacks`
  // relation above is cleared so the newly-assigned agent sees a clean lead.
  archivedFeedbacks LeadFeedbackArchive[]

  // Incremented every time this lead is reassigned "as fresh" (resetFeedbacks).
  // Feedback archived under a given reset is stamped with the cycle number it
  // belonged to, so historical follow-ups can be grouped by assignment period.
  currentCycle Int @default(1)

  // True when the CURRENT assignment (assignedTo/assignedAt/assignedBy above)
  // was made with resetFeedbacks — surfaced on the Timeline's "Assigned to X"
  // event so other roles can see that a fresh reset happened.
  lastAssignmentWasFresh Boolean @default(false)

  // Extra upload fields
  primaryApplicationConfirm String?
  primaryAdmissionConfirm   String?
  leadConfirmation          String?
  // The lead's CURRENT stage. Kept as a plain column so the leads table,
  // filters, CSV export and dropdown filtering all keep working unchanged —
  // `stageHistory` below is additive, not a replacement.
  leadStage                 String?
  leadVerification          String?
  dataCallingType           String?
  dealType                  String?
  uploadedAt                DateTime?

  // Referral chain — a lead can refer any number of new leads; the referred
  // lead is auto-assigned to the agent handling the referring lead
  referredById String?
  referredBy   Lead?   @relation("LeadReferrals", fields: [referredById], references: [id])
  referrals    Lead[]  @relation("LeadReferrals")

  // Push history when this lead triggered an external integration (e.g. LMS push)
  integrationLogs LeadIntegrationLog[]
  callLogs        CallLog[]

  // Tracks the most recent feedback option — updated on every feedback submit
  currentFeedbackOptionId String?

  // Verified / corrected student contact details (filled by counsellor)
  altEmail1    String?
  altEmail2    String?
  altPhone1    String?
  altPhone2    String?
  correctCity  String?
  correctState String?

  // Basic student info captured on the Lead Profile page
  parentName   String?
  parentMobile String?
  gender       String?
  classYear    String?
  category     String? // General, SC/ST, OBC, EWS

  createdAt DateTime @default(now())
  // Deliberately NOT `@updatedAt`. This column means "when feedback was last
  // submitted for this lead", not "when the row last changed" — the Leads table
  // shows it as UPDATED AT and the Updated Date Range filter reads it, and
  // counsellors rely on it to see genuine call activity.
  //
  // With `@updatedAt`, any incidental write bumped it: moving an agent to a
  // different Team Lead rewrites `teamId` on every one of their leads
  // (lib/team-sync.ts), which restamped hundreds of rows to the same instant
  // and buried the real activity.
  //
  // Because it has no default, Prisma requires it on create, so the compiler
  // catches every new write site. Set it ONLY where feedback is submitted:
  // app/api/leads/[id]/feedback/route.ts.
  updatedAt DateTime

  @@index([status])
  @@index([assignedToId])
  @@index([teamId])
  @@index([uploadedById])
  @@index([batchId])
  @@index([status, teamId])
  @@index([status, assignedToId])
  @@index([kappCollegeId])
  @@index([referredById])
  @@index([apiKeyId])
}

model LeadProfile {
  id                         String   @id @default(cuid())
  leadId                     String   @unique
  lead                       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  budget                     String?
  preferredCourseIds         Json? // number[] — references CourseList.csv course_id
  preferredCollegeIds        Json? // number[] — references CollegeList.csv college_id
  preferredCityNames         Json? // string[]
  preferredStateNames        Json? // string[]
  courseType                 String? // "Regular" | "Online"
  collegeType                String? // "Government" | "Private" | "Government+Private"
  specialisation             String?
  entranceExam               Json? // string[]
  scholarshipAwareness       String?
  loanRequirement            String?
  loanAmount                 String?
  paymentModePreference      String?
  stayPreference             String?
  monthlyAccommodationBudget String?
  roomSharing                String?
  mealsPreference            String?
  keyAmenities               Json? // string[]
  distanceWillingness        String?
  genderHostelRequirement    String?
  class10Percentage          String?
  class12Percentage          String?
  board                      String?
  gapYearReason              String?
  mediumOfInstruction        String?
  updatedAt                  DateTime @updatedAt
}

model FeedbackCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748b") // hex color chosen via color picker — see lib/feedback-category-colors.ts
  sortOrder Int      @default(0)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator         User             @relation("FeedbackCategoryCreator", fields: [createdBy], references: [id])
  feedbackOptions FeedbackOption[]

  @@index([sortOrder])
}

model FeedbackOption {
  id          String   @id @default(cuid())
  label       String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  categoryId  String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator           User                  @relation("FeedbackOptionCreator", fields: [createdBy], references: [id])
  category          FeedbackCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  feedbacks         LeadFeedback[]
  archivedFeedbacks LeadFeedbackArchive[]

  @@index([isActive])
  @@index([isActive, sortOrder])
  @@index([categoryId])
}

model DropdownOption {
  id              String       @id @default(cuid())
  type            DropdownType
  value           String
  kappCollegeId   String? // only used when type = COLLEGE
  // Also COLLEGE-only, same pattern as kappCollegeId above. A lead's Zone and
  // Deal Type are properties of the college it belongs to, so they are
  // configured here once and copied onto every lead ingested for that college
  // (API and CSV) instead of being sent per lead.
  collegeZone     String?
  collegeDealType String?
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  creator User @relation("DropdownOptionCreator", fields: [createdBy], references: [id])

  @@unique([type, value])
  @@index([type, isActive])
  @@index([type, isActive, sortOrder])
  @@index([kappCollegeId])
}

// Every lead stage a lead has been through, with when it arrived.
//
// The ingestion API re-sends the same lead as its stage advances. Previously
// that was rejected outright as a duplicate, so the progression was lost; now
// each new stage is appended here and Lead.leadStage is moved to the latest.
// A stage may legitimately recur (L1 -> L2 -> L1), so there is deliberately no
// unique constraint on (leadId, stage) — the API only skips a repeat of the
// stage the lead is *currently* on.
model LeadStageEntry {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage     String
  // Where the stage came from — 'API', 'CSV' or 'MANUAL'. Useful when a stage
  // looks wrong and someone needs to know which pipeline produced it.
  source    String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([stage])
}

model LeadFeedback {
  id               String         @id @default(cuid())
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId          String
  agent            User           @relation(fields: [agentId], references: [id])
  feedbackOptionId String
  feedbackOption   FeedbackOption @relation(fields: [feedbackOptionId], references: [id])
  remarks          String?
  followUpNumber   Int
  createdAt        DateTime       @default(now())

  @@index([leadId])
  @@index([agentId])
  @@index([feedbackOptionId])
  @@index([createdAt])
}

// Snapshot of a LeadFeedback row moved out of the live LeadFeedback table
// when a lead is reassigned "as fresh" (resetFeedbacks). The live table is
// cleared so the newly-assigned agent sees a clean lead, but nothing is ever
// destroyed — TL/Super Admin/Reports can still see it here via the Timeline.
model LeadFeedbackArchive {
  id               String         @id @default(cuid())
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId          String
  agent            User           @relation("ArchivedFeedbackAgent", fields: [agentId], references: [id])
  feedbackOptionId String
  feedbackOption   FeedbackOption @relation(fields: [feedbackOptionId], references: [id])
  remarks          String?
  followUpNumber   Int
  createdAt        DateTime // original feedback creation time, preserved as-is

  cycle        Int // which assignment cycle (Lead.currentCycle at the time) this belonged to
  archivedAt   DateTime @default(now())
  archivedById String?
  archivedBy   User?    @relation("ArchivedFeedbackBy", fields: [archivedById], references: [id])

  @@index([leadId])
  @@index([leadId, cycle])
}

model UploadBatch {
  id               String      @id @default(cuid())
  fileName         String
  uploadedById     String
  uploadedBy       User        @relation(fields: [uploadedById], references: [id])
  totalRecords     Int
  insertedRecords  Int         @default(0)
  duplicateRecords Int         @default(0)
  errorRecords     Int         @default(0)
  status           BatchStatus @default(COMPLETED)
  createdAt        DateTime    @default(now())

  leads Lead[]
}

model ScheduledCall {
  id           String              @id @default(cuid())
  leadId       String
  lead         Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId      String
  agent        User                @relation("AgentSchedules", fields: [agentId], references: [id])
  scheduledAt  DateTime
  note         String?
  status       ScheduledCallStatus @default(PENDING)
  reminderSent Boolean             @default(false)
  nowSent      Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([agentId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([agentId, status, reminderSent])
}

model LeadReceipt {
  id     String      @id @default(cuid())
  type   ReceiptType
  leadId String
  lead   Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  campusName        String
  couponCodeApplied Boolean @default(false)
  referralCode      String?

  paidDate      DateTime
  receiptNumber String // Application Form Number / Admission Number
  actualAmount  String?
  amountPaid    String // Final Amount Paid / Admission Amount Paid

  courseId   String
  courseName String

  studentName String
  email       String
  altEmail    String?
  mobile      String
  altMobile   String?

  city  String?
  state String

  fileOriginalName String
  filePath         String // on-disk path, relative to the private storage root
  fileMimeType     String
  fileSize         Int

  uploadedById String
  uploadedBy   User   @relation("ReceiptUploadedBy", fields: [uploadedById], references: [id])

  // Super Admin approval workflow — approving flips the lead's matching
  // Primary App./Adm. Confirm field to "Yes"; disapproving lets the agent
  // fix and resend (upload a fresh receipt of the same type).
  status            ReceiptStatus @default(PENDING)
  reviewedById      String?
  reviewedBy        User?         @relation("ReceiptReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  disapprovalReason String?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
  @@index([uploadedById])
  @@index([status])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  type       NotificationType
  title      String
  body       String
  leadId     String?
  // The exact leads a bulk "N leads assigned" notification refers to.
  //
  // Without it the drill-down had to guess, by looking for leads touched within
  // ±5 minutes of the notification. That guess broke outright once Lead.updatedAt
  // stopped tracking assignments (it now moves only on feedback), and it was
  // never reliable anyway — two assignments minutes apart contaminated each
  // other. Recording the ids at write time removes the guesswork; `leadId` above
  // still covers single-lead notifications.
  //
  // Capped when stored (see the assign routes): the viewer pages through at most
  // a hundred, so there is no reason to keep thousands of ids on one row.
  leadIds    String[]
  scheduleId String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model ActivityLog {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  action      ActivityAction
  targetId    String?
  targetType  String? // "User" | "Lead" | "Team" | "Permission"
  description String
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  content   String
  priority  AnnouncementPriority @default(NORMAL)
  isActive  Boolean              @default(true)
  createdBy String
  author    User                 @relation(fields: [createdBy], references: [id])
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([isActive, createdAt])
}

model Attendance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Calendar day this shift belongs to, "YYYY-MM-DD" in Asia/Kolkata — a
  // plain string sidesteps the naive-timestamp/timezone-cast pitfalls this
  // codebase has already been bitten by (see lib/scheduled-call-notifications.ts).
  date String

  punchInAt  DateTime
  punchOutAt DateTime?

  // Active and idle time are BOTH accumulated incrementally from the
  // client's heartbeat — never derived from (punchOutAt - punchInAt). That
  // elapsed-time approach would silently keep "working" time running for as
  // long as a shift stays open, even after the agent closes the CRM tab
  // entirely. A heartbeat only exists while the tab is open, so time the tab
  // is closed contributes to neither bucket — it's simply not measured.
  activeSeconds Int @default(0)
  idleSeconds   Int @default(0)

  // Last time any attendance action (punch/break/heartbeat) was recorded for
  // this shift — used to infer a punch-out time if the shift is never
  // explicitly closed (browser closed, laptop shut, etc).
  lastHeartbeatAt DateTime?

  // True if punchOutAt was inferred (auto-closed) rather than explicitly clicked.
  autoClosed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breaks AttendanceBreak[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

model AttendanceBreak {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  startAt      DateTime
  endAt        DateTime?

  // Null on breaks recorded before break categorization existed — those are
  // bucketed as "Other" in reports rather than guessed into one of the three.
  type BreakType?

  @@index([attendanceId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Credentials for external systems pushing leads into the CRM via
// POST /api/v1/leads (see that route for the full contract). The raw key is
// shown to the Super Admin exactly once at creation time and is never
// persisted — only its SHA-256 hash is stored, so a database leak alone
// can't be used to authenticate as an integration.
model ApiKey {
  id String @id @default(cuid())

  name String // human label, e.g. "Partner LMS — Referral Leads"

  keyHash   String @unique // sha256(raw key) — never store the raw key
  keyPrefix String // first 12 chars of the raw key, shown in the UI so an admin can tell keys apart without re-revealing them

  isActive   Boolean   @default(true)
  lastUsedAt DateTime?

  createdById String
  createdBy   User   @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  revokedAt DateTime?

  createdAt DateTime @default(now())

  leads Lead[] @relation("LeadCreatedByApiKey")

  @@index([keyHash])
  @@index([createdById])
}

// A short-lived grant that a Super Admin has verified their security PIN for
// a specific gated action (e.g. "BULK_DELETE_LEADS"). Scoped per action, not
// global, so unlocking one PIN-gated tool never unlocks another. Checked
// server-side by the protected routes themselves — the frontend PIN prompt
// is UX, this row is the actual enforcement.
model AdminActionUnlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, action])
  @@index([expiresAt])
}

// Caches a full year's holiday list from the Calendarific API, one row per
// (country, year). Fetched at most once per year — the API returns every
// holiday for the whole year in a single call, so there's no need to hit it
// daily; "today's holiday" is just a lookup against the cached data. Keeps
// us far under Calendarific's 500 calls/month free-tier limit.
model HolidayCache {
  id        String   @id @default(cuid())
  country   String
  year      Int
  data      Json
  fetchedAt DateTime @default(now())

  @@unique([country, year])
}

// A Super-Admin-configured outbound push — e.g. "send every new referral
// lead to the LMS". The endpoint/headers/body are fully editable from the
// UI (not hardcoded) since the receiving API's contract can change at any
// time; `bodyTemplate` is a raw JSON string containing literal values mixed
// with {{field}} placeholders, rendered against the triggering lead at send
// time (see lib/lead-integration-template.ts).
model LeadIntegration {
  id           String                 @id @default(cuid())
  name         String
  isActive     Boolean                @default(false) // off until an admin explicitly verifies it via Test & Send
  trigger      LeadIntegrationTrigger @default(REFERRAL_CREATED)
  method       String                 @default("POST")
  url          String
  headers      Json // [{ key, value, isSecret }] — isSecret values are AES-256-GCM encrypted, see lib/integration-crypto.ts
  queryParams  Json // [{ key, value }]
  bodyTemplate String                 @db.Text
  timeoutMs    Int                    @default(10000)

  createdById String
  createdBy   User   @relation("LeadIntegrationCreatedBy", fields: [createdById], references: [id])

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  logs LeadIntegrationLog[]

  @@index([trigger, isActive])
}

// One row per push attempt (automatic, test, or retry) — kept even on
// success so admins can audit exactly what was sent to a third party.
model LeadIntegrationLog {
  id            String          @id @default(cuid())
  integrationId String
  integration   LeadIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  // Nullable: a test send against synthetic sample data has no real lead.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  isTest       Boolean @default(false)
  retryOfLogId String? // set when this row is a manual retry of an earlier failed attempt

  requestUrl     String
  requestMethod  String
  requestHeaders Json
  requestBody    String  @db.Text
  responseStatus Int?
  responseBody   String? @db.Text
  success        Boolean
  errorMessage   String?

  attemptedAt DateTime @default(now())

  @@index([integrationId])
  @@index([leadId])
  @@index([success])
}


/// One completed call, as reported by the DialShree dialer's post-call webhook.
///
/// The dialer is the only source of talk time and recordings — the CRM's
/// click-to-call fires and forgets, and gets no call-progress events back. Rows
/// arrive after the call ends, so this table is append-mostly and never written
/// by the UI.
///
/// `leadId` and `agentId` are nullable on purpose: a call can legitimately
/// involve a number no lead holds, or a dialer seat no CRM user is mapped to.
/// Dropping those rows would lose real call activity, so they are stored
/// unmatched and can be reconciled later.
model CallLog {
  id String @id @default(cuid())

  /// The dialer's own id for the call (`dynamic_data.uniqueid`). Unique so a
  /// retried or duplicated webhook updates the row instead of adding another.
  /// Nullable because the field is not guaranteed to be present.
  uniqueId String? @unique

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  agentId String?
  agent   User?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  /// Identity exactly as the dialer reported it, kept even when matched, so an
  /// unmatched row can still be traced and a mis-match can be spotted.
  phoneCode     String?
  phoneNumber   String
  agentSeat     String?
  agentFullName String?
  agentEmail    String?

  callType String?
  campaign String?
  urlType  String?

  startedAt DateTime?
  endedAt   DateTime?

  /// Seconds, parsed from the dialer's "MM:SS" / "HH:MM:SS" strings. The raw
  /// strings are kept alongside because the provider's own sample is internally
  /// inconsistent (a 12s call with 17s of ring time), and a future format
  /// change should be visible rather than silently mis-parsed.
  durationSeconds Int?
  talkTimeSeconds Int?
  ringTimeSeconds Int?
  talkTimeRaw     String?
  ringTimeRaw     String?

  calledCount     Int?
  lastLocalCallAt DateTime?

  recordingUrl String?

  /// The untouched webhook body. Anything not modelled above is still here.
  payload Json

  receivedAt DateTime @default(now())

  @@index([leadId, startedAt])
  @@index([agentId, startedAt])
  @@index([phoneNumber])
  @@index([startedAt])
}
